# Copy to .env to override settings locally:  cp .env.example .env
# .env is git-ignored. Every value is optional; the defaults below match docker-compose.yml.
# Variables already set in the shell win over .env.

# PostgreSQL (docker-compose.yml)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=orders

# HTTP server
PORT=3000

# Idempotency keys: how long a key protects against retries (hours)
IDEMPOTENCY_KEY_TTL_HOURS=24
